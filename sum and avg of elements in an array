#include<stdio.h>
void main()
{
	int a[10],i,n,sum = 0;
	float avg;
	printf("enter the size");
	scanf("%d",&n);
	printf("enter the numbers in array :- ");
	for(i=0; i<n; i++)
	{

		scanf("%d",&a[i]);
	}
	for(i=0; i<n; i++)
	{
		sum = sum+a[i];
	}
	printf("the sum is %d",sum);
	avg = sum/n;
	printf("\nthe average is %f",avg);
}
